{
  "manifest_version": 3,
  "name": "NeonClipper",
  "version": "1.0",
  "description": "Extrae la URL y abre el portal de Notion.",
  "action": {
    "default_icon": {
      "128": "icon.png"
    },
    "default_title": "Enviar a Notion"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "windows", "tabs"],
  "host_permissions": ["https://*.notion.site/*"],
  "icons": {
    "128": "icon.png"
  }
}
